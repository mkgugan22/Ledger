# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit your actual connection string or JWT secret.
# The local values below work with the Vite dev server.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Keep localhost for development. Before deploying the API, replace or extend
# this with the exact HTTPS URL of the Netlify frontend, for example:
# CLIENT_ORIGIN=https://your-ledger-site.netlify.app
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=aksnfnsdvmlllllllllkogfuhwyo34wr03wuru03hhio#%^@&*#&^$%^#&#*(8yHEjbdnafmdvksjfskfmadvnjkmsy83r9u8y#$&*#(*$&^T&#*($87*I$(83IHrurnjbnkdfjfknvsdjbnkca
NODE_ENV=development

# Production checklist (set these on the API host, not in the frontend build):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# PORT=5000                         # or the port supplied by your host
# CLIENT_ORIGIN=https://your-ledger-site.netlify.app
# JWT_SECRET=aksnfnsdvmlllllllllkogfuhwyo34wr03wuru03hhio#%^@&*#&^$%^#&#*(8yHEjbdnafmdvksjfskfmadvnjkmsy83r9u8y#$&*#(*$&^T&#*($87*I$(83IHrurnjbnkdfjfknvsdjbnkca
# NODE_ENV=production
