MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/
PORT=5000

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

NODE_ENV=development

# ============================================================
# Ledger AI / FreeLLMAPI
# ============================================================

# FreeLLMAPI OpenAI-compatible API base URL.
#
# IMPORTANT:
# Keep the /v1 suffix.
#
# Example:
# FREELLMAPI_BASE_URL=http://localhost:3001/v1
#
# Production example:
# FREELLMAPI_BASE_URL=https://your-free-llm-api-host/v1
 FREELLMAPI_BASE_URL

# Unified FreeLLMAPI key.
#
# DO NOT commit the real key.
# DO NOT put this in client/.env.
# DO NOT prefix this with VITE_.
 FREELLMAPI_BASE_URL

# Fast routing is preferred for an interactive assistant.
#
# Other supported choices:
# auto
# auto:smart
# auto:reliable
# auto:balanced
# auto:fast
FREELLMAPI_MODEL=auto:fast

# Ledger-side maximum request time.
FREELLMAPI_TIMEOUT_MS=45000


# ============================================================
# MongoDB connection pool
# ============================================================

# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5


# ============================================================
# Production
# ============================================================

# CLIENT_ORIGIN=https://ledger0007.netlify.app
# NODE_ENV=production
