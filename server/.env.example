MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/
PORT=5000

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

NODE_ENV=development

# ============================================================
# Account recovery and email verification (Brevo)
# ============================================================

# Create a Brevo API key and configure a verified sender address.
# Keep the API key server-side; never add it to client/.env or commit it.
BREVO_API_KEY=
AUTH_EMAIL_FROM=Ledger <noreply@example.com>
# Public browser URL used for verification and password reset links.
AUTH_PUBLIC_URL=http://localhost:5173
# Enable only after Brevo sender verification and API delivery are tested.
# Existing accounts remain verified; new registrations must verify their email.
REQUIRE_EMAIL_VERIFICATION=false

# ============================================================
# Ledger AI / Gemini
# ============================================================

# Your Google AI Studio / Gemini API key.
#
# DO NOT commit the real key.
# DO NOT put this in client/.env.
# DO NOT prefix this with VITE_.
GEMINI_API_KEY=

# Gemini model used by the Ledger AI assistant.
GEMINI_MODEL=gemini-2.5-flash

# Ledger-side maximum request time (ms). Optional.
GEMINI_TIMEOUT_MS=90000

# ============================================================
# MongoDB connection pool
# ============================================================

# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5

# ============================================================
# Production
# ============================================================

# AUTH_PUBLIC_URL=https://ledger007.netlify.app
# NODE_ENV=production

# ============================================================
# Auto-SIP (optional; defaults preserve current behavior)
# ============================================================

# AUTO_SIP_ENABLED=false
# AUTO_SIP_AMOUNT=1000
# AUTO_SIP_DAY=10
# AUTO_SIP_START_MONTH=2026-11
# AUTO_SIP_EXCLUDED_FUNDS=LIC MF Consumption
