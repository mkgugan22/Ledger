MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/
PORT=5000

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

NODE_ENV=development

# Production checklist (set these on the API host — Render/Railway/etc.,
# never in the Netlify frontend build):
# MONGODB_URI=<your production connection string>
# CLIENT_ORIGIN=https://ledger007.netlify.app
# JWT_SECRET=<a different, long random value than dev>
# NODE_ENV=production
