MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/
PORT=5000

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

NODE_ENV=development

# ============================================================
# Ledger AI / Gemini
# ============================================================

# Your Google AI Studio / Gemini API key.
#
# DO NOT commit the real key.
# DO NOT put this in client/.env.
# DO NOT prefix this with VITE_.
GEMINI_API_KEY=

# Gemini model used for the Ledger AI assistant.
#
# Example:
# gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Ledger-side maximum request time (ms). Optional.
GEMINI_TIMEOUT_MS=45000


# ============================================================
# MongoDB connection pool
# ============================================================

# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5


# ============================================================
# Production
# ============================================================

# CLIENT_ORIGIN=https://ledger0007.netlify.app
# NODE_ENV=production
